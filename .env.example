# Project-specific settings
AQA_SUITE_ID=
AQA_TEST_ID=

# AQA Cloud API credentials (for AQA_METHOD=api)
AQA_API_KEY=
AQA_TEAM_SLUG=
AQA_API_HOST=api-aqa.usablenet.com

# AQA Extension API key (for AQA_SCAN_ENGINE=aqa or both — different from cloud API key)
AQA_EXTENSION_API_KEY=

# Playwright scanning method (set AQA_METHOD=playwright to use browser scanning)
AQA_METHOD=api
AQA_URLS=

# Scan engine: 'axe' (free axe-core), 'aqa' (licensed UsableNet Page Capture),
#              'aqa-main' (main AQA extension for direct eval), or 'both' (axe + aqa)
AQA_SCAN_ENGINE=axe

# AQA engine settings (only needed when AQA_SCAN_ENGINE=aqa or both)
AQA_FLOW_NAME=
AQA_TEST_NAME=
AQA_RULESET_PACK_ID=v2
AQA_RULESET_ID=wcag22
AQA_CLEANUP_FLOW=false

# Playwright browser settings
AQA_PLAYWRIGHT_HEADLESS=true
AQA_PLAYWRIGHT_TIMEOUT=30000
AQA_PLAYWRIGHT_CONCURRENCY=3
AQA_PLAYWRIGHT_SCREENSHOTS=false
AQA_PLAYWRIGHT_WAIT_AFTER_LOAD=2000

# AQA main extension settings (only needed when AQA_SCAN_ENGINE=aqa-main)
# User API key for the main AQA extension (X-User-Key header)
# This is the personal API key from the AQA extension options page — different from AQA_EXTENSION_API_KEY
# Find it in: Chrome → AQA extension icon → Settings → API Key
AQA_USER_API_KEY=
# Max time to wait for AQA extension evaluation to complete (ms)
AQA_MAIN_EVALUATION_TIMEOUT=120000
SONARQUBE_PROJECT_KEY=
APIIRO_REPO_NAME=

# Feature flags
AUTO_APPROVE_ENABLED=true
AUTO_APPROVE_MAX_LINES=10

# Scheduling (cron expressions)
FETCH_CRON_APIIRO=0 8 * * 1-5
FETCH_CRON_AQA=0 9 * * 1-5
FETCH_CRON_SONARQUBE=0 10 * * 1-5

# Notifications
NOTIFICATION_WEBHOOK_URL=

# CI
CI_WAIT=true

# Dashboard
DASHBOARD_PORT=8000
