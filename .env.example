# ============================================
# Credentials & Project Identifiers
# ============================================

# --- AQA (UsableNet) ---
AQA_API_KEY=                  # Cloud API key (X-Team header)
AQA_TEAM_SLUG=                # Team slug
AQA_TEST_ID=                  # Default test ID for API fetch
AQA_USER_API_KEY=             # Personal key for AQA extension engine

# --- Apiiro ---
APIIRO_REPO_NAME=             # Repository name in Apiiro

# --- SonarQube ---
SONARQUBE_PROJECT_KEY=        # SonarQube project key

# ============================================
# Feature Flags
# ============================================
AUTO_APPROVE_ENABLED=true
AUTO_APPROVE_MAX_LINES=10

# ============================================
# Infrastructure
# ============================================
DASHBOARD_PORT=8000
